# ==============================================================================
# AI EVALUATION WORKER CONFIGURATION (.env.example)
# ==============================================================================

# 1. Chọn Provider: "local_ai" (Ollama / Qwen3 trên AWS EC2 - Mặc định) | "deepseek" | "gemini"
AI_PROVIDER=local_ai

# 2. Cấu hình Local AI trên AWS EC2 (Ollama OpenAI-compatible endpoint)
LOCAL_AI_BASE_URL=http://localhost:11434/v1/chat/completions
LOCAL_AI_MODEL=qwen3:4b
LOCAL_AI_API_KEY=ollama
LOCAL_AI_TIMEOUT=300
LOCAL_AI_NUM_CTX=16384
# Đặt false để tự động chèn /no_think giúp Qwen3 trả JSON nhanh, không tốn token <think>
LOCAL_AI_THINK_MODE=false

# Giới hạn tổng số ký tự source code đưa vào context để bảo vệ RAM/VRAM trên EC2
CODE_CLEANER_MAX_TOTAL_CHARS=35000

# 3. Cấu hình Fallback Cloud AI (Chỉ dùng khi AI_PROVIDER=deepseek hoặc gemini)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
