# Docker --env-file syntax (no shell quotes). Copy privately on the deploy host.
# Use exactly the same URL/catalog as DEPLOY_RUNTIME_JDBC_URL.
BE1_MIGRATION_JDBC_URL=jdbc:mysql://REPLACE_RDS_ENDPOINT:3306/fcaj_poc?sslMode=VERIFY_IDENTITY&serverTimezone=UTC&connectTimeout=5000&socketTimeout=30000
BE1_MIGRATION_USERNAME=
BE1_MIGRATION_PASSWORD=
# Copy the public passwordless truststore from the candidate release image. It keeps
# the runtime JRE's public roots as well as the regional RDS roots. No private keys.
# Mounted at this same container path by deploy-verified.sh and both Compose examples.
JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/run/secrets/rds-truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12
