# AWS RUNTIME VARIABLE REFERENCE - not loaded automatically by Spring.
# BE2 injects actual values into the process; never commit filled-in secrets.
# S3/SQS clients use the AWS default credential chain / EC2 role, never hardcoded keys.
SPRING_PROFILES_ACTIVE=aws

# BE2: existing database endpoint/user/secret. Do not include credentials in URL.
# VERIFY_IDENTITY needs the RDS CA trusted by the runtime JVM/driver truststore.
# The release image includes public JRE roots + RDS roots in a passwordless store.
# For the operator-mounted copy, use the public path options in migration.env.example.
# Never place DB credentials or a private truststore password in JAVA_TOOL_OPTIONS.
SPRING_DATASOURCE_URL=jdbc:mysql://<rds-endpoint>:3306/fcaj_poc?sslMode=VERIFY_IDENTITY&serverTimezone=UTC&connectTimeout=5000&socketTimeout=30000
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# DB_USERNAME/DB_PASSWORD are compatible aliases; prefer the standard names above.
# Flyway V1/V2/V3 own DDL, Hibernate validates. No automatic baseline, clean or update.
# Restore + reviewed baseline-v1 is a separate operator step for an existing DB.

# Owner/BE2: stable Base64 signing secret encoding >=32 random bytes.
JWT_SECRET=
# Lead/FE/BE2: actual HTTPS frontend origin (no path, query, or fragment).
APP_FRONTEND_URL=https://app.<root-domain>
# Optional comma-separated HTTPS origins; defaults to APP_FRONTEND_URL only.
# APP_CORS_ALLOWED_ORIGINS=https://app.<root-domain>
JWT_COOKIE_SECURE=true
# Parent domain only, no scheme/path. Leave empty for same-host API tooling;
# sibling frontend/API browser acceptance requires the confirmed shared domain.
CSRF_COOKIE_DOMAIN=

# Owner: only enable for deliberate initial provisioning with external credentials.
BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
SEED_SCENARIO=NONE

# BE2 outputs: private bucket, isolated root prefix and region. Logical references
# are relative to this prefix; backend and worker MUST use the same mapping.
AWS_REGION=ap-southeast-1
APP_STORAGE_BUCKET=
APP_STORAGE_PREFIX=
# S3 remains required in the aws profile even when AI jobs are disabled.

# Keep off until the agreed worker, queue pair and IAM identities are available.
# Only the MOCK pipeline is accepted by this release. This is real S3/SQS delivery
# with a synthetic worker result, distinct from the local H2 mock-demo profile.
APP_AI_JOBS_ENABLED=false
APP_AI_JOBS_JOBS_QUEUE_URL=
APP_AI_JOBS_RESULTS_QUEUE_URL=
# When jobs are enabled, false deliberately pauses BOTH outbox dispatch and result polling;
# POST can still create pending jobs. Enable delivery only in the agreed queue window.
APP_AI_JOBS_DELIVERY_ENABLED=false
# APP_BUILD_REVISION=<actual 40-character source commit included in the image>

# Optional OAuth owner: append oauth-google and/or oauth-github to ACTIVE profiles
# and provide credentials ONLY for enabled providers. Register callbacks at
# https://<api-host>/login/oauth2/code/google (or github).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional mail/model owner: SMTP is not required for boot; email flows need these values.
# There is no new mail-disable flag. The real AI model is outside this MOCK milestone.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# GEMINI_API_KEY=
# GITHUB_TOKEN=

# Forwarded headers are enabled. BE2 restricts target access to the trusted ALB SG
# for the proposed direct topology, or the local reverse proxy for the loopback variant.
# ALB port/protocol/TLS, FE HTTPS/domain and browser cookie/CSRF acceptance remain pending.
