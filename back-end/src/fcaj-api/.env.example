# Copy this file to `.env` in the same folder and fill in the values you need.
# `.env` is gitignored — never commit real secrets.
# Any value left unset falls back to the default shown in application.properties.

# =============================================
# DATABASE
# =============================================
DB_USERNAME=root
DB_PASSWORD=

# =============================================
# JWT
# Must be Base64-encoded, at least 256 bits (32 bytes).
# =============================================
JWT_SECRET=
# true in prod (HTTPS), false for local dev (plain HTTP)
JWT_COOKIE_SECURE=false
# Blank for localhost. In production, use the shared parent domain (no scheme).
CSRF_COOKIE_DOMAIN=

# =============================================
# DEMO DATA SEEDING
# NONE | S0 | S1 | S2 | S25 | S3
# =============================================
SEED_SCENARIO=NONE

# =============================================
# OAUTH2 - GOOGLE
# =============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================
# OAUTH2 - GITHUB
# =============================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================
# APP CONFIG
# =============================================
APP_FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_OTP_EXPIRATION_MINUTES=10

# =============================================
# AI - GOOGLE GEMINI (Judge Assistant, optional)
# Get a key at https://aistudio.google.com/app/apikey
# Leaving GEMINI_API_KEY unset disables the feature gracefully.
# =============================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# =============================================
# AI - GITHUB REPO ANALYSIS (Judge Assistant, optional)
# Create a token at https://github.com/settings/tokens (scope: public_repo, or
# repo for private). Unset still works for public repos, rate-limited to ~60/hr.
# =============================================
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# =============================================
# MAIL / GMAIL SMTP
# Use a Gmail app password, not your account password.
# =============================================
MAIL_USERNAME=
MAIL_PASSWORD=

# =============================================
# FILE UPLOADS
# =============================================
UPLOAD_DIR=uploads
PROBLEM_DIR=protected/problems
