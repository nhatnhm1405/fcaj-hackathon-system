# LOCAL DEVELOPMENT ONLY: copy to .env in this folder (Java properties syntax).
# .env is gitignored and imported only by the local profile. Never commit secrets.
# Set active profiles in the shell/IDE, not inside this imported file:
#   SPRING_PROFILES_ACTIVE=local
# Optional providers: local,oauth-google and/or local,oauth-github.
# With no explicit profile the default is local. AWS uses .env.aws.example as a
# variable reference for runtime injection; it does not import either .env file.

# Database: set your local password. Standard SPRING_DATASOURCE_* OS environment
# variables take precedence over the compatible DB_USERNAME/DB_PASSWORD aliases.
DB_USERNAME=root
DB_PASSWORD=
# Flyway owns schema changes; Hibernate validates. Existing databases without
# history require a reviewed V1 baseline before startup. Never reset a DB to migrate.

# Local has a public development-only JWT key. To override, uncomment and supply
# a Base64 value encoding >=32 random bytes. Do not leave an enabled override blank.
# JWT_SECRET=
JWT_COOKIE_SECURE=false
CSRF_COOKIE_DOMAIN=

# Administrator creation is opt-in in EVERY environment. Supply credentials
# externally; SEED_SCENARIO alone never creates a bootstrap administrator.
# Enable this to provision an admin on a fresh DB or to run the S3 demo scenario.
BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# NONE | S1 | S25 | S3. S3 needs the configured existing global admin.
SEED_SCENARIO=NONE

# OAuth is off unless the matching oauth-google/oauth-github profile is active.
# An enabled provider requires BOTH values; the other provider remains optional.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

APP_FRONTEND_URL=http://localhost:5173
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
PASSWORD_RESET_OTP_EXPIRATION_MINUTES=10

# Optional synchronous AI. Missing key keeps AI unavailable without blocking boot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# Configure SMTP before using approval/reset emails. No startup network check.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Existing local storage; these paths are not S3 configuration.
UPLOAD_DIR=uploads
PROBLEM_DIR=protected/problems
