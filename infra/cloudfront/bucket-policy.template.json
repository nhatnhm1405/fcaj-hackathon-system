{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowFcajFrontendCloudFrontRead",
      "Effect": "Allow",
      "Principal": {"Service": "cloudfront.amazonaws.com"},
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::fcaj-poc-web-582129522297-ap-southeast-1/*",
      "Condition": {"StringEquals": {"AWS:SourceArn": "REPLACE_DISTRIBUTION_ARN"}}
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::fcaj-poc-web-582129522297-ap-southeast-1",
        "arn:aws:s3:::fcaj-poc-web-582129522297-ap-southeast-1/*"
      ],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }
  ]
}
